{
  "name": "CyberLab (cloud dev)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "cd backend && pip install -e '.[dev]'",
  "forwardPorts": [8000],
  "containerEnv": {
    "CYBERLAB_ENVIRONMENT": "development",
    "CYBERLAB_AUTH_MODE": "dev"
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
