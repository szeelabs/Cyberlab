# Copy to backend/.env for local development. Never commit real values.
CYBERLAB_ENVIRONMENT=development
CYBERLAB_DATABASE_URL=sqlite:///./cyberlab-dev.db
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/cyberlab

# "dev" = fixed local identity (refused in production). "jwt" = verify provider tokens.
CYBERLAB_AUTH_MODE=dev
# Supabase Auth (Project Settings -> API). HS256 legacy secret OR asymmetric JWKS:
# CYBERLAB_AUTH_JWT_SECRET=
# CYBERLAB_AUTH_ALGORITHMS=["ES256"]
# CYBERLAB_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# CYBERLAB_AUTH_ISSUER=https://<project>.supabase.co/auth/v1
CYBERLAB_AUTH_AUDIENCE=authenticated

# Execution: "none" (default, NOT CONNECTED) or "docker"
CYBERLAB_EXECUTION_PROVIDER=none
# Remote Docker host (optional), e.g. ssh://cyberlab@your-server
# CYBERLAB_DOCKER_HOST=
# Pull Docker Hub images through a mirror to avoid rate limits (optional)
# CYBERLAB_IMAGE_MIRROR=mirror.gcr.io

# Largest file the workspace file API will upload or download (bytes)
# CYBERLAB_MAX_FILE_BYTES=26214400

# Snapshots (local store for now)
# CYBERLAB_SNAPSHOT_DIR=./cyberlab-data/snapshots
# CYBERLAB_MAX_SNAPSHOT_BYTES=1073741824
# CYBERLAB_MAX_SNAPSHOTS_PER_WORKSPACE=10
# Largest bundle accepted by /v1/workspaces/import (bytes)
# CYBERLAB_MAX_BUNDLE_BYTES=2147483648
# Encrypt snapshots (required for S3). Generate: python -m cyberlab.storage.keygen
# Keep it secret and backed up: without it, encrypted snapshots cannot be restored.
# CYBERLAB_SNAPSHOT_ENCRYPTION_KEY=
# S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3, MinIO). Needs: pip install 'cyberlab[s3]'
# CYBERLAB_SNAPSHOT_STORE=s3
# CYBERLAB_S3_BUCKET=
# CYBERLAB_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# CYBERLAB_S3_REGION=auto
# CYBERLAB_S3_ACCESS_KEY_ID=
# CYBERLAB_S3_SECRET_ACCESS_KEY=

# Egress proxy image for restricted-egress environments (optional)
# CYBERLAB_EGRESS_PROXY_IMAGE=docker.io/library/python:3.13-slim

# Browser terminal limits (optional)
# CYBERLAB_TERMINAL_TICKET_TTL_SECONDS=60
# CYBERLAB_TERMINAL_IDLE_TIMEOUT_SECONDS=900
# CYBERLAB_TERMINAL_MAX_SESSION_SECONDS=7200
# CYBERLAB_TERMINAL_MAX_SESSIONS_PER_USER=3

CYBERLAB_CORS_ORIGINS=["http://localhost:3000"]

# Quotas (per user)
CYBERLAB_QUOTA_MAX_ENVIRONMENTS=4
CYBERLAB_QUOTA_MAX_TOTAL_CPU=6
CYBERLAB_QUOTA_MAX_TOTAL_MEMORY_MIB=12288
CYBERLAB_QUOTA_MAX_TOTAL_STORAGE_GIB=40
