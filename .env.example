# Copy to backend/.env for local development. Never commit real values.
CYBERLAB_ENVIRONMENT=development
CYBERLAB_DATABASE_URL=sqlite:///./cyberlab-dev.db
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/cyberlab

# "dev" = fixed local identity (refused in production). "jwt" = verify provider tokens.
CYBERLAB_AUTH_MODE=dev
# Supabase Auth (Project Settings -> API). HS256 legacy secret OR asymmetric JWKS:
# CYBERLAB_AUTH_JWT_SECRET=
# CYBERLAB_AUTH_ALGORITHMS=["ES256"]
# CYBERLAB_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# CYBERLAB_AUTH_ISSUER=https://<project>.supabase.co/auth/v1
CYBERLAB_AUTH_AUDIENCE=authenticated

# Execution: "none" (default, NOT CONNECTED) or "docker"
CYBERLAB_EXECUTION_PROVIDER=none
# Remote Docker host (optional), e.g. ssh://cyberlab@your-server
# CYBERLAB_DOCKER_HOST=
# Pull Docker Hub images through a mirror to avoid rate limits (optional)
# CYBERLAB_IMAGE_MIRROR=mirror.gcr.io

CYBERLAB_CORS_ORIGINS=["http://localhost:3000"]

# Quotas (per user)
CYBERLAB_QUOTA_MAX_ENVIRONMENTS=4
CYBERLAB_QUOTA_MAX_TOTAL_CPU=6
CYBERLAB_QUOTA_MAX_TOTAL_MEMORY_MIB=12288
CYBERLAB_QUOTA_MAX_TOTAL_STORAGE_GIB=40
